# =============================================================================
#  Aquí Estuve — Variables de entorno
#  Copia este archivo a `.env` (cp .env.example .env) y rellena los valores.
#  `.env` NUNCA se sube al repositorio (está en .gitignore).
#
#  Convención de Astro: solo las variables con prefijo PUBLIC_ llegan al
#  navegador. Todo lo demás es exclusivo del servidor. Aquí NO hay ninguna
#  variable PUBLIC_ a propósito: el cliente no necesita secretos ni el
#  cloud name (las URLs de Cloudinary se derivan de `imageUrl` guardada en BD).
# =============================================================================


# -----------------------------------------------------------------------------
# [Tanda 1] App
# -----------------------------------------------------------------------------

# URL pública canónica del sitio (sin barra final).
# Desarrollo: http://localhost:4321  ·  Producción: https://tu-dominio.com (o https://<proyecto>.vercel.app)
# En Vercel, todas estas variables se definen en Settings → Environment Variables.
SITE_URL=http://localhost:4321


# -----------------------------------------------------------------------------
# [Tanda 1] MongoDB
# -----------------------------------------------------------------------------

# Cadena de conexión. Recomendado: MongoDB Atlas (cluster M0 gratuito).
# Atlas → Database → Connect → Drivers → Node.js → copiar el "connection string"
# y sustituir <password>. Recuerda permitir tu IP en Network Access.
# Atlas es un replica set ⇒ soporta transacciones (Better Auth las usa).
# Si usas un mongod local standalone, pon MONGODB_TRANSACTIONS=false.
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=aqui-estuve

# Nombre de la base de datos que usará la app.
MONGODB_DB=aqui_estuve

# true (por defecto) con Atlas/replica set; false con mongod standalone local.
MONGODB_TRANSACTIONS=true


# -----------------------------------------------------------------------------
# [Tanda 2] Better Auth
# -----------------------------------------------------------------------------

# Secreto para firmar/cifrar cookies y tokens. Mínimo 32 caracteres aleatorios.
# Generar con:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL base donde corre la app (Better Auth la usa para cookies y CSRF).
# Debe coincidir EXACTAMENTE con el origen desde el que abres el navegador.
BETTER_AUTH_URL=http://localhost:4321

# Único correo autorizado como administrador. Cualquier otro registro se rechaza.
ADMIN_EMAIL=tu-correo@ejemplo.com

# Solo los usa `npm run seed:admin` para crear la cuenta la primera vez.
# Tras ejecutar el seed puedes borrar ADMIN_PASSWORD de tu .env.
# Mínimo 12 caracteres.
ADMIN_NAME=Tu Nombre
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# [Tanda 3] Cloudinary
# -----------------------------------------------------------------------------

# Cloudinary Console → Settings (⚙) → "API Keys" (o el Dashboard principal):
# ahí aparecen Cloud name, API Key y API Secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Carpeta dentro de tu Media Library donde se guardarán las fotos.
CLOUDINARY_FOLDER=aqui-estuve

# Tamaño máximo de foto (en MB). Se valida en el formulario antes de subir y en
# el servidor al registrar. La subida va directa a Cloudinary (firmada), así que
# el límite de 4,5 MB de Vercel no aplica. Plan gratuito de Cloudinary: máx. 10 MB.
UPLOAD_MAX_MB=10


# -----------------------------------------------------------------------------
# [Tanda 5] Likes anónimos
# -----------------------------------------------------------------------------

# Sal secreta para hashear IPs con SHA-256 (nunca se guarda la IP en claro).
# Generar con:  openssl rand -hex 32
# ⚠ Si la cambias, todos los "likes" previos dejarán de reconocerse.
LIKES_IP_SALT=

# ¿Confiar en la cabecera X-Forwarded-For?
#   Local (npm run dev): false → se usa la IP del socket.
#   Vercel (producción): true  → su edge sobrescribe X-Forwarded-For con la IP real.
TRUST_PROXY=false
